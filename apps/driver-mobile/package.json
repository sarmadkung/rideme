{
  "name": "@apps/driver-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@platform/([^/]+)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@platform/config": "workspace:*",
    "@platform/types": "workspace:*",
    "@platform/ui": "workspace:*",
    "expo": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@platform/api-client": "workspace:*",
    "@platform/validation": "workspace:*",
    "expo-secure-store": "~15.0.7",
    "expo-application": "~7.0.7",
    "zod": "^4.1.13",
    "@platform/mobile": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
