# =============================================================================
# RideMe — example environment. Copy to .env.local and fill in.
#   cp .env.example .env.local
# .env.local and .env.test are gitignored. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server — Go API (services/api). Secrets live here. Never exposed to clients.
# -----------------------------------------------------------------------------
APP_ENV=development
API_PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://logistics:logistics@localhost:5432/logistics_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=logistics-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Signs access tokens and keys OTP hashes (roadmap Phase 3). Must be at least
# 32 bytes. A different value per environment: sharing one across environments
# means a staging token is a production token.
JWT_SECRET=dev-only-change-me-in-every-other-environment

# Provider selection. In development the OTP code is written to the log instead
# of being sent; the API refuses to start in production without a real provider.
OTP_PROVIDER=noop
MAP_PROVIDER=noop

# Google Maps. Two variables, deliberately: the server key and the mobile key
# carry mutually exclusive restrictions in Google Cloud Console, so one key
# cannot safely be both.
#
# MAPS_API_KEY is secret and belongs to the server. Restrict it by IP.
# MAPS_MOBILE_API_KEY is read at BUILD time by each app's app.config.js and
# baked into the binary, so it is public by construction; its only protection
# is an Android package-name + SHA-1 and iOS bundle-id restriction.
#
# Real values live in .env.local, which is gitignored. This repository is
# public: a key committed here is a key a scraper bills to your account within
# minutes.
MAPS_API_KEY=
MAPS_MOBILE_API_KEY=

# -----------------------------------------------------------------------------
# Local infrastructure — consumed by infra/docker/docker-compose.yml only.
# -----------------------------------------------------------------------------
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
POSTGRES_DB=logistics_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Client — PUBLIC. Anything below ships inside the app bundle.
# Never put a secret behind a VITE_ or EXPO_PUBLIC_ prefix.
# -----------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8080

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
