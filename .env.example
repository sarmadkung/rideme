# =============================================================================
# RideMe — example environment. Copy to .env.local and fill in.
#   cp .env.example .env.local
# .env.local and .env.test are gitignored. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server — Go API (services/api). Secrets live here. Never exposed to clients.
# -----------------------------------------------------------------------------
APP_ENV=development
API_PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://logistics:logistics@localhost:5432/logistics_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=logistics-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Phase 4 (authentication). Present so configuration validation is exercised;
# no auth surface exists in Phase 1.
JWT_SECRET=dev-only-change-me-in-every-other-environment

# Provider selection. Adapters arrive with their own slices (Phase 4+).
OTP_PROVIDER=noop
MAP_PROVIDER=noop

# -----------------------------------------------------------------------------
# Local infrastructure — consumed by infra/docker/docker-compose.yml only.
# -----------------------------------------------------------------------------
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
POSTGRES_DB=logistics_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Client — PUBLIC. Anything below ships inside the app bundle.
# Never put a secret behind a VITE_ or EXPO_PUBLIC_ prefix.
# -----------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8080

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
